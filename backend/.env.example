PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://127.0.0.1:27017/hello-buddy
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_change_me_in_prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_change_me_in_prod
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_signing_secret_key

# Brevo (Sendinblue) Transactional Email
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@hellobuddy.ai
BREVO_SENDER_NAME=HelloBuddy AI Career Prep

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Qdrant Vector Database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=career_prep_vectors

# AI Providers (Groq with Qwen & Google Gemini latest)
DEFAULT_AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=qwen-2.5-32b
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Voice / TTS / STT
KOKORO_API_URL=http://127.0.0.1:8880/v1
